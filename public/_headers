# Match next-books Cloudflare HTML Cache-Control (static SPA shell).
/
  Cache-Control: private, no-cache, no-store, max-age=0, must-revalidate

/index.html
  Cache-Control: private, no-cache, no-store, max-age=0, must-revalidate

# Vite writes content-hashed files to /assets, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
