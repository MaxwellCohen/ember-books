{
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/server/**"
    }
  },
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "optimized": true
    }
  }
}
