{
  "name": "ember-books",
  "version": "0.0.0",
  "private": true,
  "description": "Goodreads catalog app built with Ember",
  "repository": "https://github.com/MaxwellCohen/ember-books",
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build && vite build --ssr app/app-ssr.js && node scripts/prepare-server-template.mjs",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "node server.js --dev",
    "preview": "node server.js",
    "test": "vite build --mode development && ember test --path dist/client",
    "preview:cloudflare": "npm run build && cp dist/server/template.html dist/client/index.html && npx --yes wrangler@4.131.2 dev",
    "deploy:cloudflare": "npm run build && cp dist/server/template.html dist/client/index.html && npx --yes wrangler@4.131.2 deploy",
    "deploy:netlify": "npm run build && cp dist/server/template.html dist/client/index.html && npx --yes netlify deploy --prod --dir dist/client --functions netlify/functions --skip-functions-cache",
    "deploy:vercel": "npx --yes vercel deploy --prod --yes"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.22",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.3",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.6",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.9",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@warp-drive/core": "~5.8.2",
    "@warp-drive/ember": "~5.8.2",
    "@warp-drive/json-api": "~5.8.2",
    "@warp-drive/legacy": "~5.8.2",
    "@warp-drive/utilities": "~5.8.2",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.4",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~7.2.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.2.0",
    "ember-strict-application-resolver": "^0.1.1",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-warp-drive": "^5.8.2",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.7",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "testem": "^3.20.1",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">= 22"
  },
  "ember": {
    "edition": "octane"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/middie": "^9.3.4",
    "@fastify/static": "^10.1.3",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite-ember-ssr": "^0.4.1"
  }
}
